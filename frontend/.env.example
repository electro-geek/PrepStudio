# ─────────────────────────────────────────────────────────────────────────────
# LearnForge Frontend — Environment Variable Template
# Copy this file to .env.local and fill in your real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK ───────────────────────────────────────────────────────
# Get these from your Firebase Console → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Backend API URL ───────────────────────────────────────────────────────────
# Set to your deployed Vercel backend URL in production.
# Example: https://learnforge-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000
